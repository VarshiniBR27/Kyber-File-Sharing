{
  "name": "kyber-file-sharing",
  "version": "1.0.0",
  "private": true,
  "description": "Post-quantum secure file sharing prototype using ML-KEM-768 and AES-256-GCM",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.7.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  }
}
